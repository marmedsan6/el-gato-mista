{
  "permissions": {
    "deny": [
      "Read(./.runtime/claves/**)",
      "Edit(./.runtime/claves/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(cat *.runtime/claves*)",
      "Bash(type *.runtime/claves*)"
    ]
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.sh\"",
            "timeout": 180,
            "statusMessage": "Verificando los tests del motor..."
          }
        ]
      }
    ]
  }
}
